package com.example.demo.model;


import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import jakarta.transaction.Transactional;

@Service
@Transactional
public class ProfilesService {
	
	@Autowired
	private ProfilesRepository pRepos;
	
	public Profiles insert(Profiles p) {
		return pRepos.save(p);
	}
	
	public Profiles update(Profiles p) {
		return pRepos.save(p);
	}
	
	public void deleteById(Integer id) {
		pRepos.deleteById(id);
	}
	
	public Profiles selectById(Integer id) {
		Optional<Profiles> op = pRepos.findById(id);
		
		if(op.isPresent()) {
			return op.get();
		}
		
		return null;
	}
	
	public List<Profiles> selectAll(){
		return pRepos.findAll();
	}

}