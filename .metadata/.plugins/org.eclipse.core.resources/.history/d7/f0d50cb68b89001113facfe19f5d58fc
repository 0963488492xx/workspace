<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <title>LoginSystem</title>
</head>

<body>
    <h3>LoginSystem</h3>
    <form action="checklogin.controller" method="post"></form>
    <table>
        <tr>
            <td>UserName:</td>
            <td><input type="text" name="userName"></td>
            <td th:if="${erros!=null and erros['name']!=null}" th:text="${erros['name']}"></td>
        </tr>
        <tr>
            <td>Password</td>
            <td><input type="password" name="userPwd"></td>
            <td th:if="${erros!=null and erros['pwd']!=null}" th:text="${erros['pwd']}"></td>
        </tr>
        <tr>
            <td><button type="submit">login</button></td>
            <td th:if="${erros!=null and erros['msg']!=null}" th:text="${erros['msg']}"></td>

        </tr>

    </table>
</body>

</html>