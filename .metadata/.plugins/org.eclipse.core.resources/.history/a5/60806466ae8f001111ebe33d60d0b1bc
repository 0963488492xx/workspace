package com.example.demo.model;


public class Animal {

	
	
	
	private Integer aid;
	private String aname;
	
	public Animal() {
		
	}

	public Animal(Integer aid, String aname) {
		super();
		this.aid = aid;
		this.aname = aname;
	}

	public Integer getAid() {
		return aid;
	}

	public void setAid(Integer aid) {
		this.aid = aid;
	}

	public String getAname() {
		return aname;
	}

	public void setAname(String aname) {
		this.aname = aname;
	}
	
	

}
