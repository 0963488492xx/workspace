spring.application.name=DemoSpringBootProjectWeb


#Tomcat Server Port Setting
server.port=8081

#information Setting
name=mary
age=18


#static resources Setting
spring.web.resources.static-locations=/WEB-INF/resources/,classpath:/static
spring.mvc.static-path-pattern=/**

