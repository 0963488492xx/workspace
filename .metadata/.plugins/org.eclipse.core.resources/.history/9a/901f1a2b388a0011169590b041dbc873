package com.example.demo.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.example.demo.model.Users;
import com.example.demo.model.UsersService;

@RestController
@RequestMapping("/users")
public class UsersController {

	@Autowired
	private UsersService uService;
	
	@GetMapping("/findusers1.controller")
	public List<Users> processFindUsersAction1(){
		return uService.findUsers("an");
		
	}
	
	@GetMapping("/findbyusername.controller")
	public Users processFindUsersByUsernameAction() {
		return uService.findByUsername("frank");
	}
	
	@GetMapping("findbyidandusername.controller")
	public Users processFindUsersByUsernameAndId() {
		return uService.findByIdAndUsername(1, "janet");
	}
	
	@GetMapping("/findallusers.controller")
	public List<Users> processFindAllSction(){
		return uService.findAll();
	}
}
